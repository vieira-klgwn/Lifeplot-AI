{
  "name": "@lifepilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cors": "2.8.5",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "16.4.5",
    "express": "5.2.1",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "jsonwebtoken": "9.0.3",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.20.3",
    "@types/supertest": "6.0.2",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
