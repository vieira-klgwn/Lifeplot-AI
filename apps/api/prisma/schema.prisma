generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  APPLE
}

enum EventCategory {
  CLASS
  EXAM
  ASSIGNMENT
  MEETING
  STUDY
  PERSONAL
  OTHER
}

enum TaskStatus {
  PENDING
  SCHEDULED
  DONE
  CANCELLED
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String?
  authProvider      AuthProvider @default(PASSWORD)
  providerSubject   String?
  name              String
  university        String?
  timezone          String   @default("UTC")
  weekStartsOn      Int      @default(1) // 0 = Sunday, 1 = Monday
  defaultReminderMinutes Int @default(10)
  categoryReminderMinutes Json @default("{}")
  notificationsEnabled Boolean @default(true)
  analyticsEnabled  Boolean  @default(true)
  pushToken         String?
  onboardedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  events        Event[]
  tasks         Task[]
  reminders     Reminder[]
  conversations Conversation[]
  sessions      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  recurringRules RecurrenceRule[]

  @@unique([authProvider, providerSubject])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A recurring series (e.g. a class that meets Mon/Wed/Fri). Occurrences are
/// materialised as Event rows so that per-occurrence edits are trivial.
model RecurrenceRule {
  id         String   @id @default(uuid())
  userId     String
  title      String
  courseCode String?
  professor  String?
  location   String?
  category   EventCategory @default(CLASS)
  /// 0 = Sunday ... 6 = Saturday
  byWeekday  Int[]
  /// Local wall-clock times in the user's timezone, "HH:mm"
  startTime  String
  endTime    String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  timezone   String
  reminderMinutes Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]

  @@index([userId])
}

model Event {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  category    EventCategory @default(OTHER)
  recurrenceRuleId String?
  /// Set when this event was generated from a recurrence rule.
  occurrenceDate DateTime? @db.Date
  cancelled   Boolean  @default(false)
  createdBy   String   @default("USER") // USER | AI | IMPORT
  taskId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrenceRule RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: Cascade)
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reminders      Reminder[]

  @@index([userId, startTime])
  @@index([recurrenceRuleId])
}

model Task {
  id                String   @id @default(uuid())
  userId            String
  title             String
  description       String?
  deadline          DateTime?
  estimatedMinutes  Int?
  status            TaskStatus @default(PENDING)
  category          EventCategory @default(ASSIGNMENT)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    Event[]
  reminders Reminder[]

  @@index([userId, deadline])
}

model Reminder {
  id            String   @id @default(uuid())
  userId        String
  eventId       String?
  taskId        String?
  minutesBefore Int
  fireAt        DateTime
  status        ReminderStatus @default(PENDING)
  sentAt        DateTime?
  failureReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  task  Task?  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([status, fireAt])
  @@index([userId])
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  /// Structured payload: proposed actions, tool results, undo tokens.
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}
