# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma separated list of allowed origins for browser clients. Mobile apps do not send Origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lifepilot?schema=public

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- Social sign-in (verified server side, no client secrets in the app) ----
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ---- AI provider ----
# openai | local  (local = deterministic rule based parser, no network required)
AI_PROVIDER=local
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Notifications ----
# Local mobile notifications are authoritative. The legacy push worker is disabled.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
REMINDER_WORKER_ENABLED=false
